# Discord — application-level credentials only. This bot is multi-guild: it
# can be installed into any number of servers with the same token/client
# id/secret, so there's no DISCORD_GUILD_ID here anymore. Per-guild settings
# (verified role, start-here/mod-review/audit-log channels, allowed
# countries, etc.) are configured per server from /admin → "Server setup",
# seeded with defaults the first time the bot joins a new guild.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# From the Developer Portal's OAuth2 tab. Required for the admin panel's
# Discord login (/admin) — the token exchange needs it, not just the client ID.
DISCORD_CLIENT_SECRET=

# Optional, default false. When true, the bot immediately leaves any server
# it's newly invited to instead of provisioning it — guilds it already
# serves are unaffected. Useful to stop growth without taking the bot
# offline.
DISALLOW_NEW_GUILDS=false

# Database (MariaDB/MySQL). Use the mysql:// scheme even for MariaDB, and
# percent-encode any special characters in the username/password (e.g. & -> %26, ^ -> %5E, % -> %25, $ -> %24).
DATABASE_URL=mysql://user:password@localhost:3306/discord_verify

# Web server
PORT=3000
PUBLIC_BASE_URL=https://verify.example.com
# Random long string used to sign admin panel session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# GeoIP / VPN detection is fully self-hosted and open source, no API key
# needed: a GeoLite2-derived country database + a known-VPN-network CIDR list
# are downloaded on startup into data/geoip/ and refreshed automatically
# every 12h (see src/geo/updater.ts, src/jobs/geoUpdater.ts).

# Optional, default off. Private/loopback IPs (e.g. testing locally against
# `npm run dev` with no reverse proxy, or a proxy that isn't forwarding the
# real IP) have no GeoIP data, so the visitor's browser is asked to report
# its own public IP instead (via a third-party lookup) and that's used for
# the check. Only enable this where you trust the visitor's browser more
# than you trust your network path — a visitor can report any IP they like,
# so leaving this on in production behind a misconfigured proxy would let
# anyone bypass country/VPN restrictions.
GEO_ALLOW_CLIENT_IP_FALLBACK=false

# Cloudflare Turnstile CAPTCHA on the manual-review form (name/email step).
# Get both from https://dash.cloudflare.com/ -> Turnstile -> Add site
# (the domain doesn't need to already use Cloudflare for DNS/proxying).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Seed defaults only ---
# These three are only used as the starting template whenever the bot joins
# a *new* guild (see src/bot/events/guildCreate.ts) — each guild then has
# its own independently-editable copy in the admin panel (/admin). Editing
# these env vars later has no effect on guilds that already exist.

# Comma-separated ISO 3166-1 alpha-2 country codes that auto-verify when not on a VPN
ALLOWED_COUNTRIES=US,CA,GB

# Max acceptable IPQS fraud_score (0-100) before routing to manual review
MAX_FRAUD_SCORE=75

# Whether to DM new members a verification link automatically on join.
# Members can always self-serve with /verify regardless of this setting.
SEND_JOIN_DM=true
