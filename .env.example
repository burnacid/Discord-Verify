# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_VERIFIED_ROLE_ID=
# Channel where join-page-less members without open DMs get a fallback message
DISCORD_START_HERE_CHANNEL_ID=
# Channel where mods see review-queue embeds with Approve/Deny buttons
DISCORD_MOD_REVIEW_CHANNEL_ID=
# Optional: read-only channel that gets a permanent log entry for every
# verify/unverify/approve/deny decision (review-queue messages themselves
# get deleted after a decision, so this is the only lasting record in Discord)
DISCORD_AUDIT_LOG_CHANNEL_ID=

# Database (MariaDB/MySQL). Use the mysql:// scheme even for MariaDB, and
# percent-encode any special characters in the username/password (e.g. & -> %26, ^ -> %5E, % -> %25, $ -> %24).
DATABASE_URL=mysql://user:password@localhost:3306/discord_verify

# Web server
PORT=3000
PUBLIC_BASE_URL=https://verify.example.com

# GeoIP / VPN detection (IPQualityScore)
IPQS_API_KEY=

# Comma-separated ISO 3166-1 alpha-2 country codes that auto-verify when not on a VPN
ALLOWED_COUNTRIES=US,CA,GB

# Max acceptable IPQS fraud_score (0-100) before routing to manual review
MAX_FRAUD_SCORE=75

# Set to "false" to disable the automatic DM sent when a member joins
# (and its channel fallback in DISCORD_START_HERE_CHANNEL_ID). Members can
# still verify themselves anytime with /verify. Defaults to true.
SEND_JOIN_DM=true
