generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  unverified
  verified
  pending_review
  rejected
}

enum ReviewReason {
  vpn
  country
}

enum ReviewStatus {
  pending
  approved
  denied
}

model Member {
  discordId   String       @id
  guildId     String
  status      MemberStatus @default(unverified)
  country     String?
  ipRiskScore Int?
  lastIp      String?
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  tokens      VerificationToken[]
  reviewQueue ReviewQueueEntry[]
}

model VerificationToken {
  token     String    @id @default(uuid())
  discordId String
  member    Member    @relation(fields: [discordId], references: [discordId])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Cached GeoIP/VPN check result, filled in on first page load so page
  // reloads (e.g. while filling out the manual-review form) don't re-query
  // the provider or risk getting a different result mid-flow.
  geoIp         String?
  geoCountry    String?
  geoFraudScore Int?
  geoIsVpn      Boolean?
  geoRaw        Json?
  geoCheckedAt  DateTime?

  @@index([discordId])
}

model InviteLink {
  code      String   @id
  guildId   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([guildId, expiresAt])
}

// Singleton row (id is always 1) holding runtime-editable settings that
// were previously env-only. Seeded from .env defaults on first boot if the
// row doesn't exist yet; edited live from the admin panel afterward.
model Settings {
  id               Int      @id @default(1)
  allowedCountries String
  maxFraudScore    Int
  sendJoinDm       Boolean
  updatedAt        DateTime @updatedAt
}

model RssFeed {
  id           String    @id @default(uuid())
  name         String
  feedUrl      String
  channelId    String
  enabled      Boolean   @default(true)
  template     String?
  lastGuid     String?
  lastPostedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Singleton row (id always 1) holding the default RSS post template used by
// feeds that don't set their own — same pattern as the Settings model, but
// scoped to the RSS module rather than mixed into the main Settings table.
model RssSettings {
  id              Int      @id @default(1)
  defaultTemplate String
  updatedAt       DateTime @updatedAt
}

model JtcTrigger {
  id        String   @id @default(uuid())
  channelId String   @unique
  name      String
  createdAt DateTime @default(now())
}

// No relation/cascade to JtcTrigger on purpose: deleting a trigger must not
// touch channels it already spawned — they still need to be tracked here
// until they empty out and get cleaned up normally.
model JtcChannel {
  id        String   @id @default(uuid())
  channelId String   @unique
  triggerId String
  number    Int
  createdAt DateTime @default(now())
}

model ReviewQueueEntry {
  id         String       @id @default(uuid())
  discordId  String
  member     Member       @relation(fields: [discordId], references: [discordId])
  reason     ReviewReason
  ipInfo     Json
  name       String       @default("")
  email      String       @default("")
  status     ReviewStatus @default(pending)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([discordId])
  @@index([status])
}
