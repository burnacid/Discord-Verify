generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  unverified
  verified
  pending_review
  rejected
}

enum ReviewReason {
  vpn
  country
}

enum ReviewStatus {
  pending
  approved
  denied
}

model Member {
  discordId   String       @id
  guildId     String
  status      MemberStatus @default(unverified)
  country     String?
  ipRiskScore Int?
  lastIp      String?
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  tokens      VerificationToken[]
  reviewQueue ReviewQueueEntry[]
}

model VerificationToken {
  token     String    @id @default(uuid())
  discordId String
  member    Member    @relation(fields: [discordId], references: [discordId])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Cached GeoIP/VPN check result, filled in on first page load so page
  // reloads (e.g. while filling out the manual-review form) don't re-query
  // the provider or risk getting a different result mid-flow.
  geoIp         String?
  geoCountry    String?
  geoFraudScore Int?
  geoIsVpn      Boolean?
  geoRaw        Json?
  geoCheckedAt  DateTime?

  @@index([discordId])
}

model InviteLink {
  code      String   @id
  guildId   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([guildId, expiresAt])
}

// Singleton row (id is always 1) holding runtime-editable settings that
// were previously env-only. Seeded from .env defaults on first boot if the
// row doesn't exist yet; edited live from the admin panel afterward.
model Settings {
  id               Int      @id @default(1)
  allowedCountries String
  maxFraudScore    Int
  sendJoinDm       Boolean
  updatedAt        DateTime @updatedAt
}

model RssFeed {
  id           String    @id @default(uuid())
  name         String
  feedUrl      String
  channelId    String
  enabled      Boolean   @default(true)
  template     String?   @db.Text
  lastGuid     String?
  lastPostedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Singleton row (id always 1) holding the default RSS post template used by
// feeds that don't set their own — same pattern as the Settings model, but
// scoped to the RSS module rather than mixed into the main Settings table.
model RssSettings {
  id              Int      @id @default(1)
  defaultTemplate String   @db.Text
  updatedAt       DateTime @updatedAt
}

model JtcTrigger {
  id        String   @id @default(uuid())
  channelId String   @unique
  name      String
  createdAt DateTime @default(now())
}

// No relation/cascade to JtcTrigger on purpose: deleting a trigger must not
// touch channels it already spawned — they still need to be tracked here
// until they empty out and get cleaned up normally.
model JtcChannel {
  id        String   @id @default(uuid())
  channelId String   @unique
  triggerId String
  number    Int
  createdAt DateTime @default(now())
}

// Singleton row (id always 1) holding the join-welcome message config —
// same pattern as Settings/RssSettings, scoped to this module.
model WelcomeSettings {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  channelId String?
  template  String   @db.Text
  updatedAt DateTime @updatedAt
}

// Singleton row (id always 1) — configures a channel that, when a
// not-yet-verified member posts in it, gets sent a verification link by DM.
// Same pattern as WelcomeSettings.
model VerifyPromptSettings {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  channelId String?
  updatedAt DateTime @updatedAt
}

model EventSource {
  id              String    @id @default(uuid())
  name            String
  provider        String    @default("custom") // "custom" | "tribe" (WordPress The Events Calendar)
  apiUrl          String
  timezone        String    @default("Europe/Amsterdam")
  durationMinutes Int       @default(240)
  lookaheadDays   Int       @default(7) // "tribe" provider only: only fetch/create events within this many days
  nameFilter      String?   @db.Text // comma-separated keywords; blank/null = no filter
  nameFilterMode  String    @default("include") // "include" = only sync matches; "exclude" = sync everything except matches
  messageChannelId String? // null = don't post per-event messages; not every API needs this
  messageTemplate String   @db.Text @default("{{description}}") // embed description body; title/fields are structured separately
  mentionRoleId   String? // role to @-mention when a new event message is first posted (null = no mention)
  enabled         Boolean   @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// No DB-level relation/cascade to EventSource — deleting a source must also
// delete the live Discord scheduled events/messages it created, which a DB
// cascade can't do by itself. That cleanup happens explicitly in
// deleteAllEventsForSource() (src/jobs/eventSync.ts), called before the
// EventSource row (and these rows) are removed.
model EventSourceItem {
  id             String    @id @default(uuid())
  sourceId       String
  externalId     String
  discordEventId String
  // Cached start time of the underlying event — lets a windowed provider
  // (tribe) distinguish "genuinely cancelled/filtered out" from "just
  // outside our current fetch window" without wrongly deleting the latter.
  startUtc       DateTime  @default(now())
  // Cached end time — lets us detect "this event is done" independently of
  // whether the item is still listed in the API (some APIs keep past items
  // around indefinitely), so the posted message gets cleaned up promptly.
  endUtc         DateTime  @default(now())
  // The per-event channel message this item posted, if the source has
  // messages enabled — null if messages aren't configured for this source.
  messageId      String?
  apiUpdatedAt   DateTime?
  createdAt      DateTime  @default(now())

  @@unique([sourceId, externalId])
}

model ReviewQueueEntry {
  id         String       @id @default(uuid())
  discordId  String
  member     Member       @relation(fields: [discordId], references: [discordId])
  reason     ReviewReason
  ipInfo     Json
  name       String       @default("")
  email      String       @default("")
  status     ReviewStatus @default(pending)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([discordId])
  @@index([status])
}
