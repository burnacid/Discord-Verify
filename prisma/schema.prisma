generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  unverified
  verified
  pending_review
  rejected
}

enum ReviewReason {
  vpn
  country
}

enum ReviewStatus {
  pending
  approved
  denied
}

// One row per Discord server this bot is installed in. Populated by the
// guildCreate handler (src/bot/events/guildCreate.ts) and a startup
// reconciliation pass (src/index.ts) — backs the admin login server picker
// and the sidebar switcher without a live Discord API call per request.
model Guild {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
}

model Member {
  discordId   String
  guildId     String
  status      MemberStatus @default(unverified)
  country     String?
  ipRiskScore Int?
  lastIp      String?
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  tokens      VerificationToken[]
  reviewQueue ReviewQueueEntry[]

  // Composite PK, not discordId alone — the same Discord user can be a
  // member of multiple guilds this bot serves, each with independent
  // verification status. (This used to be `discordId @id`, which silently
  // conflated a user's status across every guild they were in — see the
  // migration notes in the multi-guild plan for backfilling existing rows
  // before this constraint is applied.)
  @@id([discordId, guildId])
  @@index([status])
}

model VerificationToken {
  token     String    @id @default(uuid())
  discordId String
  guildId   String
  member    Member    @relation(fields: [discordId, guildId], references: [discordId, guildId])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Cached GeoIP/VPN check result, filled in on first page load so page
  // reloads (e.g. while filling out the manual-review form) don't re-query
  // the provider or risk getting a different result mid-flow.
  geoIp         String?
  geoCountry    String?
  geoFraudScore Int?
  geoIsVpn      Boolean?
  geoRaw        Json?
  geoCheckedAt  DateTime?

  @@index([discordId, guildId])
}

model InviteLink {
  code      String   @id
  guildId   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([guildId, expiresAt])
}

// One row per /join page visit that carried a ?ref= query param — lets
// admins see which campaigns/sources are driving people to the join page.
// Not tied to a specific InviteLink row: invites are cached/shared across
// visitors (see getOrCreateJoinInvite in src/bot/inviteManager.ts), so a
// single invite code says nothing about how any one visitor got there.
model InviteReferral {
  id        String   @id @default(uuid())
  guildId   String
  ref       String
  createdAt DateTime @default(now())

  @@index([guildId, ref])
  @@index([guildId, createdAt])
}

// One row per guild holding runtime-editable settings that used to be
// env-only and/or a single global row. Seeded with defaults when a guild is
// first added (see guildCreate.ts); edited live from the admin panel
// afterward. verifiedRoleId/startHereChannelId/modReviewChannelId/
// auditLogChannelId used to be DISCORD_*_ID env vars — impossible to keep
// as env vars once there's more than one guild, so they live here now.
model Settings {
  guildId            String   @id
  allowedCountries   String
  maxFraudScore      Int
  sendJoinDm         Boolean
  verifiedRoleId     String?
  startHereChannelId String?
  modReviewChannelId String?
  auditLogChannelId  String?
  updatedAt          DateTime @updatedAt
}

// One row per background job (keyed by the same string each job registers
// itself under in src/jobs/registry.ts), tracking its most recent run for
// the admin "Scheduled Tasks" page — updated by runTracked() (src/jobs/
// jobTracking.ts) on every scheduled tick and every manual "Run now".
model JobRun {
  key            String    @id
  lastRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastError      String?   @db.Text
  lastDurationMs Int?
}

model RssFeed {
  id            String    @id @default(uuid())
  guildId       String
  name          String
  feedUrl       String
  channelId     String
  enabled       Boolean   @default(true)
  template      String?   @db.Text
  lastGuid      String?
  lastPostedAt  DateTime?
  // Set on every poll attempt (success or failure) — unlike lastPostedAt,
  // which only advances when a new item is actually found/posted, so a
  // quiet-but-healthy feed and a broken one used to look identical.
  lastCheckedAt DateTime?
  // Human-readable reason for the most recent poll failure; cleared on the
  // next successful poll. Null = last poll (if any) succeeded.
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([guildId])
}

// One row per guild holding the default RSS post template used by feeds
// that don't set their own — same pattern as Settings, scoped to the RSS
// module rather than mixed into the main Settings table.
model RssSettings {
  guildId         String   @id
  defaultTemplate String   @db.Text
  updatedAt       DateTime @updatedAt
}

model JtcTrigger {
  id        String   @id @default(uuid())
  guildId   String
  channelId String   @unique
  name      String
  createdAt DateTime @default(now())

  @@index([guildId])
}

// No relation/cascade to JtcTrigger on purpose: deleting a trigger must not
// touch channels it already spawned — they still need to be tracked here
// until they empty out and get cleaned up normally.
model JtcChannel {
  id        String   @id @default(uuid())
  guildId   String
  channelId String   @unique
  triggerId String
  number    Int
  createdAt DateTime @default(now())

  @@index([guildId])
}

// One row per guild holding the join-welcome message config — same pattern
// as Settings/RssSettings, scoped to this module.
model WelcomeSettings {
  guildId   String   @id
  enabled   Boolean  @default(false)
  channelId String?
  template  String   @db.Text
  updatedAt DateTime @updatedAt
}

// One row per guild — configures a channel that, when a not-yet-verified
// member posts in it, gets sent a verification link by DM. Same pattern as
// WelcomeSettings.
model VerifyPromptSettings {
  guildId   String   @id
  enabled   Boolean  @default(false)
  channelId String?
  updatedAt DateTime @updatedAt
}

model EventSource {
  id                 String    @id @default(uuid())
  guildId            String
  name               String
  provider           String    @default("custom") // "custom" | "tribe" (WordPress The Events Calendar)
  apiUrl             String
  timezone           String    @default("Europe/Amsterdam")
  durationMinutes    Int       @default(240)
  lookaheadDays      Int       @default(7) // "tribe" provider only: only fetch/create events within this many days
  nameFilter         String?   @db.Text // comma-separated keywords; blank/null = no filter
  nameFilterMode     String    @default("include") // "include" = only sync matches; "exclude" = sync everything except matches
  categoryFilter     String?   @db.Text // "tribe" provider only: comma-separated category slugs; blank/null = no filter
  categoryFilterMode String    @default("include") // "include" = only sync matching categories; "exclude" = sync everything except matches
  messageChannelId   String? // null = don't post per-event messages; not every API needs this
  messageTemplate    String    @default("{{description}}") @db.Text // embed description body; title/fields are structured separately
  mentionRoleId      String? // role to @-mention when a new event message is first posted (null = no mention)
  enabled            Boolean   @default(true)
  // Only advances on a successful sync (see syncEventSource in
  // src/jobs/eventSync.ts), so staleness alone is already a usable signal —
  // lastError adds a human-readable reason instead of just "it's been a while".
  lastSyncedAt       DateTime?
  lastError          String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([guildId])
}

// No DB-level relation/cascade to EventSource — deleting a source must also
// delete the live Discord scheduled events/messages it created, which a DB
// cascade can't do by itself. That cleanup happens explicitly in
// deleteAllEventsForSource() (src/jobs/eventSync.ts), called before the
// EventSource row (and these rows) are removed.
model EventSourceItem {
  id             String    @id @default(uuid())
  guildId        String
  sourceId       String
  externalId     String
  discordEventId String
  // Cached start time of the underlying event — lets a windowed provider
  // (tribe) distinguish "genuinely cancelled/filtered out" from "just
  // outside our current fetch window" without wrongly deleting the latter.
  startUtc       DateTime  @default(now())
  // Cached end time — lets us detect "this event is done" independently of
  // whether the item is still listed in the API (some APIs keep past items
  // around indefinitely), so the posted message gets cleaned up promptly.
  endUtc         DateTime  @default(now())
  // The per-event channel message this item posted, if the source has
  // messages enabled — null if messages aren't configured for this source.
  messageId      String?
  apiUpdatedAt   DateTime?
  createdAt      DateTime  @default(now())

  @@unique([sourceId, externalId])
  @@index([guildId])
}

model ReviewQueueEntry {
  id         String       @id @default(uuid())
  discordId  String
  guildId    String
  member     Member       @relation(fields: [discordId, guildId], references: [discordId, guildId])
  reason     ReviewReason
  ipInfo     Json
  name       String       @default("")
  email      String       @default("")
  status     ReviewStatus @default(pending)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  // Mod-review channel message ID for the Approve/Deny embed, so it can be
  // edited (buttons removed, resolution shown) once a decision is made.
  messageId  String?
  // Optional free-text reason a mod attaches when denying — from the web
  // panel's textarea or the Discord deny modal. Null on approve.
  reviewNote String?      @db.Text

  @@index([discordId, guildId])
  @@index([guildId, status])
}
